# .env.example — copy to .env.local and fill in values (never commit .env.local)

# ── Namecheap Private Email SMTP ─────────────────────────────────────────────
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@bestcreativehub.com
SMTP_PASSWORD=

# ── Sender aliases (optional overrides; defaults shown) ───────────────────────
# SMTP_FROM_BOOKINGS=Best Creative Hub <bookings@bestcreativehub.com>
# SMTP_FROM_CONTACT=Best Creative Hub <contact@bestcreativehub.com>
# SMTP_FROM_INFO=Best Creative Hub <info@bestcreativehub.com>
# SMTP_FROM_ADMIN=Best Creative Hub <admin@bestcreativehub.com>

# ── Application ───────────────────────────────────────────────────────────────
# The email address to receive admin notifications
ADMIN_EMAIL=admin@bestcreativehub.com
# The public URL of your deployed application
APP_URL=https://bestcreativehub.com

# ── Firebase Client ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (Server-Side) ──────────────────────────────────────────
# Service account credentials for secure server-side operations and token verification
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key should include newline characters or be quoted: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ── Paystack Payment Gateway ──────────────────────────────────────────────────
# Server-side secret key for transaction initialization and verification
PAYSTACK_SECRET_KEY=
# Client-side public key for Paystack Inline popup (Phase 6)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Appointment commitment fee percentage (defaults to 30% if omitted)
COMMITMENT_FEE_PERCENTAGE=30
