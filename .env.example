# .env.example — copy to .env.local and fill in values (never commit .env.local)

# ── Namecheap Private Email SMTP ─────────────────────────────────────────────
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@bestcreativehub.com
SMTP_PASSWORD=

# ── Sender aliases (optional overrides; defaults shown) ───────────────────────
# SMTP_FROM_BOOKINGS=Best Creative Hub <bookings@bestcreativehub.com>
# SMTP_FROM_CONTACT=Best Creative Hub <contact@bestcreativehub.com>
# SMTP_FROM_INFO=Best Creative Hub <info@bestcreativehub.com>
# SMTP_FROM_ADMIN=Best Creative Hub <admin@bestcreativehub.com>

# ── Application ───────────────────────────────────────────────────────────────
# The email address to receive admin notifications
ADMIN_EMAIL=admin@bestcreativehub.com
# The public URL of your deployed application
APP_URL=https://bestcreativehub.com

# ── Firebase ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
